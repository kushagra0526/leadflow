# Copy to .env for `docker compose`.
# Running locally without Docker needs no .env: the backend defaults to SQLite
# and the frontend to http://localhost:8000.

# Postgres
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# Backend
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@db:5432/leadflow
CORS_ORIGINS=http://localhost:3000

# Frontend (read at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
