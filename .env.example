# Settings LeadFlow reads. Every value has a default, so `docker compose up --build`
# works without a .env file. To change one, copy this file to `.env` and edit it.
# Only Docker Compose reads this file. Without Docker, set backend values in your shell
# and NEXT_PUBLIC_API_URL in frontend/.env.local (see README, "Configuration").

# Postgres (docker compose)
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# Backend
# In Docker, DATABASE_URL is built from the POSTGRES_* values above.
# Without Docker the backend uses a local SQLite file (sqlite:///./leadflow.db) unless you set it, e.g.:
# DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (read at build time and baked into the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000
